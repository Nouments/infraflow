/system identity set name="{{.Name}}"
{{range .Interfaces}}{{if eq .IPv4Mode "static"}}{
	:local addressEntry [/ip address find where comment="{{.Owner}}"];
	:if ([:len $addressEntry] = 0) do={:set addressEntry [/ip address find where address="{{.IPv4Address}}" interface="{{.Name}}" !dynamic]};
	:if ([:len $addressEntry] = 0) do={/ip address add address={{.IPv4Address}} interface="{{.Name}}" comment="{{.Owner}}"} else={/ip address set $addressEntry address={{.IPv4Address}} interface="{{.Name}}" comment="{{.Owner}}"}
}
{{else if eq .IPv4Mode "dhcp"}}{
	:local dhcpEntry [/ip dhcp-client find where comment="{{.Owner}}"];
	:if ([:len $dhcpEntry] = 0) do={:set dhcpEntry [/ip dhcp-client find where interface="{{.Name}}"]};
	:if ([:len $dhcpEntry] = 0) do={/ip dhcp-client add interface="{{.Name}}" disabled=no comment="{{.Owner}}"} else={/ip dhcp-client set $dhcpEntry interface="{{.Name}}" disabled=no comment="{{.Owner}}"}
}
{{end}}{{end}}{{range .Routes}}{
	:local routeEntry [/ip route find where comment="{{.Owner}}"];
	:if ([:len $routeEntry] = 0) do={:set routeEntry [/ip route find where dst-address="{{.Destination}}" gateway="{{.Gateway}}" !dynamic]};
	:if ([:len $routeEntry] = 0) do={/ip route add dst-address={{.Destination}} gateway="{{.Gateway}}" distance={{if .Distance}}{{.Distance}}{{else}}1{{end}} comment="{{.Owner}}"} else={/ip route set $routeEntry dst-address={{.Destination}} gateway="{{.Gateway}}" distance={{if .Distance}}{{.Distance}}{{else}}1{{end}} comment="{{.Owner}}"}
}
{{end}}{{if .OSPF}}{
	:local ospfInstance [/routing ospf instance find where name="infraflow-v2"];
	:if ([:len $ospfInstance] = 0) do={/routing ospf instance add name=infraflow-v2 version=2 router-id={{.OSPF.RouterID}}} else={/routing ospf instance set $ospfInstance router-id={{.OSPF.RouterID}}}
}
{{range .OSPF.Areas}}{
	:local ospfArea [/routing ospf area find where name="{{.Name}}"];
	:if ([:len $ospfArea] = 0) do={/routing ospf area add name={{.Name}} area-id={{.ID}} instance=infraflow-v2} else={/routing ospf area set $ospfArea area-id={{.ID}} instance=infraflow-v2}
}
{{end}}{{range .OSPF.Networks}}{
	:local ospfTemplate [/routing ospf interface-template find where comment="{{.Owner}}"];
	:if ([:len $ospfTemplate] = 0) do={:set ospfTemplate [/routing ospf interface-template find where networks="{{.RouterOSNetwork}}" area={{.AreaName}}]};
	:if ([:len $ospfTemplate] = 0) do={/routing ospf interface-template add networks={{.RouterOSNetwork}} area={{.AreaName}} comment="{{.Owner}}"} else={/routing ospf interface-template set $ospfTemplate networks={{.RouterOSNetwork}} area={{.AreaName}} comment="{{.Owner}}"}
}
{{end}}{{end}}
