FROM golang:1.25-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/infraflow-agent ./agent/cmd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app

COPY --from=build /out/infraflow-agent /usr/local/bin/infraflow-agent
COPY docker/agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
COPY docker/agent-config.yaml /etc/infraflow/agent-config.yaml

RUN chmod +x /usr/local/bin/agent-entrypoint.sh \
    && mkdir -p /data/agent /etc/infraflow/tls

ENTRYPOINT ["/usr/local/bin/agent-entrypoint.sh"]
CMD ["run", "-config", "/etc/infraflow/agent-config.yaml"]
